{
  "realm": "timeline",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Управляет роадмапом, задачами, спринтами и планом" },
      { "name": "MEMBER", "description": "Смотрит план и ведёт собственный отпуск" }
    ]
  },
  "defaultRoles": [],
  "clients": [
    {
      "clientId": "timeline-web",
      "name": "Timeline SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:*", "http://127.0.0.1:*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:*"
      }
    },
    {
      "clientId": "timeline-backend",
      "name": "Фоновые задачи сервисов",
      "enabled": true,
      "publicClient": false,
      "secret": "timeline-backend-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
