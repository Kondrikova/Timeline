  "panels": [
    {
      "title": "HTTP RPS по сервисам",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "title": "Outbox pending",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "outbox_pending",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "title": "Outbox oldest age (s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "outbox_oldest_pending_age_seconds",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "title": "Saga stuck / DLT",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "saga_stuck", "legendFormat": "saga {{application}}" },
        { "expr": "kafka_dlt_messages_total", "legendFormat": "dlt {{application}}" }
      ]
    },
    {
      "title": "Лаг проекции доски (s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "board_projection_lag_seconds",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ],
