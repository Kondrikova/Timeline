{
  "info": {
    "name": "Timeline — сценарии защиты",
    "description": "Коллекция по сценариям из docs/architecture.md §17.\n\nПеред прогоном: docker compose up, затем Get admin token / Get member token.\nИдентификаторы дисциплин, спринтов и задач сохраняются в переменные коллекции тестами.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8090" },
    { "key": "realm", "value": "timeline" },
    { "key": "clientId", "value": "timeline-web" },
    { "key": "adminToken", "value": "" },
    { "key": "memberToken", "value": "" },
    { "key": "disciplineId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "sprint1Id", "value": "" },
    { "key": "sprint2Id", "value": "" },
    { "key": "epicId", "value": "" },
    { "key": "task1Id", "value": "" },
    { "key": "task2Id", "value": "" },
    { "key": "linkId", "value": "" },
    { "key": "vacationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get admin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token получен', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{clientId}}" },
                { "key": "username", "value": "anna.admin" },
                { "key": "password", "value": "admin123" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        },
        {
          "name": "Get member token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token получен', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('memberToken', body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{clientId}}" },
                { "key": "username", "value": "petr.dev" },
                { "key": "password", "value": "member123" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "0. Настройка команды",
      "item": [
        {
          "name": "Создать дисциплину BACKEND",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('disciplineId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"BACKEND\",\n  \"name\": \"Разработка\",\n  \"velocitySpPerSprint\": 20\n}"
            },
            "url": "{{baseUrl}}/api/v1/disciplines"
          }
        },
        {
          "name": "Добавить сотрудника Петра",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
