            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": { \"2026-01-01\": false, \"2026-01-02\": false },\n  \"comment\": \"Новогодние\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/calendar/days"
          }
        }
      ]
