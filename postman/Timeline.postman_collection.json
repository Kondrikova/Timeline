            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"22222222-2222-2222-2222-222222222222\",\n  \"fullName\": \"Пётр\",\n  \"disciplineId\": \"{{disciplineId}}\",\n  \"lead\": false,\n  \"activeFrom\": \"2026-01-01\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/team/members"
          }
        },
        {
          "name": "Календарь: праздник",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"]
